PORT=3000

# OpenAI Chat Completions API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Open Exchange Rates API (https://openexchangerates.org/)
OPEN_EXCHANGE_RATES_APP_ID=

# PostgreSQL connection (see docker-compose.yml for local defaults)
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_USER=wizybot
DATABASE_PASSWORD=wizybot
DATABASE_NAME=wizybot

# Path to the CSV file used by the seed script (relative to backend/)
CSV_PRODUCTS_PATH=./data/products_list.csv
